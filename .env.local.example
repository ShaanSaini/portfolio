# Copy this file to .env.local for local development.
# Both values also need to be set as Environment Variables on the Vercel
# project (Settings -> Environment Variables) for the deployed site.

# Auto-populated when you connect a Vercel Blob store to this project via
# `vercel env pull .env.local`. If setting it by hand, get it from
# Vercel dashboard -> Storage -> your Blob store -> ".env.local" tab.
BLOB_READ_WRITE_TOKEN=

# Password for the /admin dashboard. Pick anything reasonably strong —
# there's no username, just this one shared password.
ADMIN_PASSWORD=
